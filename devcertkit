#!/usr/bin/env bash
#
# devcertkit -- A toolkit for managing development and internal certificates.
#
# This tool provides a simplified wrapper around EasyRSA to manage
# internal SSL/VPN certificates, specifically tailored for:
#   - Homelab environments
#   - Internal HTTPS services
#   - VPN infrastructure
#   - Development environments
#
# It serves as the main entry point for the toolkit, orchestrating
# initialization and dispatching commands to specific modules.
#
# Project: https://github.com/nedron92/devcertkit
#

set -Eeuo pipefail

SCRIPT_NAME="$(basename "$0")"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

## Load variables and basic functionality
# shellcheck source=./scripts/common/shared.sh
source "${SCRIPT_DIR}/scripts/common/shared.sh"
# shellcheck source=./scripts/common/paths.sh
source "${SCRIPT_DIR}/scripts/common/paths.sh"
# shellcheck source=./scripts/common/easyrsa-prepare.sh
source "${SCRIPT_DIR}/scripts/common/easyrsa-prepare.sh"
# shellcheck source=./scripts/ssl/ssl-commands.sh
source "${SCRIPT_DIR}/scripts/ssl/ssl-commands.sh"
# shellcheck source=./scripts/vpn/vpn-commands.sh
source "${SCRIPT_DIR}/scripts/vpn/vpn-commands.sh"

# -----------------------------
# Helper
# -----------------------------
show_help() {
  # Displays the main help message for the devcertkit tool,
  # listing available commands and global options.

  cat <<EOF
Usage: ./devcertkit <command> [options]

devcertkit is a helper toolkit for managing internal SSL/VPN certificates.
It simplifies PKI management using EasyRSA as a backend.

Commands:
  init        Initializes the workspace, resolves EasyRSA, and prepares the environment.
  ssl         SSL-specific commands (init, ca, cert)
  vpn         VPN-specific commands (init, ca, client)
  version     Show the current version
  help        Show this help message

Options:
  -h, --help               Show this help message
  -v, --version            Show the current version
  --easyrsa-path <path>    Path to the installed EasyRSA directory

Examples:
  ./devcertkit init
  ./devcertkit ssl init
  ./devcertkit vpn init
  ./devcertkit vpn help
  ./devcertkit ssl help
EOF
}

show_version() {
  # Displays the current version of devcertkit.
  # The version is read from the VERSION file in the project root.

  local version_file="${SCRIPT_DIR}/VERSION"
  if [[ -f "$version_file" ]]; then
    VERSION="$(cat "$version_file")"
    info "devcertkit ${VERSION}"
    info "Internal SSL/VPN certificate toolkit"
  else
    warn "devcertkit version (unknown)"
  fi
}

# -----------------------------
# General operation
# -----------------------------
init_easyrsa() {
  # Resolves the EasyRSA installation and creates a symlink in the workspace.
  # If the binary is already linked and executable, it skips resolution.
  # Arguments:
  #   $1: optional path to EasyRSA provided by the user

  local easyrsa_path="${1:-${EASYRSA_PATH:-}}"
  local easyrsa_path_found

  if [[ -x "${EASYRSA_BIN}" ]]; then
    info " EasyRSA binary already exists at ${EASYRSA_BIN}, skipping resolution."
  else
    info "Resolving EasyRSA..."
    easyrsa_path_found="$(resolve_easyrsa "$easyrsa_path")"
    ln -sfn "$easyrsa_path_found" "${EASYRSA_DIR}"
  fi
}

run_init() {
  # Initializes the devcertkit workspace.
  # This includes creating runtime and output directories, and setting up EasyRSA.
  # Arguments:
  #   $@: arguments passed to the init command (e.g., --easyrsa-path)

  local user_easyrsa_path=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)
        show_help
        exit 0
        ;;
      --easyrsa-path)
        if [[ -n "${2:-}" && "$2" != -* ]]; then
          user_easyrsa_path="$2"
          shift 2
        else
          fail " --easyrsa-path requires an argument."
        fi
        ;;
      *)
        fail " Unknown argument: $1"
        ;;
    esac
  done

  info "Initializing devcertkit workspace..."

  if [[ ! -d "${RUNTIME_DIR}" ]]; then
    info " Preparing runtime directory: ${RUNTIME_DIR}"
    prepare_dir "${RUNTIME_DIR}"
  fi

  if [[ ! -d "${OUTPUT_DIR}" ]]; then
    info " Preparing output directory: ${OUTPUT_DIR}"
    prepare_dir "${OUTPUT_DIR}"
  fi

  info "\nInitialize easyrsa."
  init_easyrsa "$user_easyrsa_path"

  info "\nDone. Workspace is ready."
  info "  EasyRSA: ${EASYRSA_DIR}"
  info "  Runtime: ${RUNTIME_DIR}"
  info "  Output:  ${OUTPUT_DIR}"
  info "  SSL-PKI: ${SSL_PKI_DIR}"
}

# -----------------------------
# Main
# -----------------------------
MAIN_CMD="${1:-}"
[[ -n "${MAIN_CMD}" ]] && shift || true

case "${MAIN_CMD}" in
  init)
    run_init "$@"
    ;;
  ssl)
    run_ssl_commands "$@"
    ;;
  vpn)
    run_vpn_commands "$@"
    ;;
  version|-v|--version)
    show_version
    exit 0
    ;;
  -h|--help|help|"?")
    show_help
    exit 0
    ;;
  "")
    show_help
    exit 0
    ;;
  *)
    warn "Unknown command: ${MAIN_CMD}"
    show_help
    exit 1
    ;;
esac
