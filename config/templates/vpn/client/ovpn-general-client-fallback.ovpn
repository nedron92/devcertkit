## TYPE GENERAL
## TCP fallback client, full-tunnel, for restrictive networks

client
dev tun
proto tcp-client
tcp-nodelay

ca ca.crt
cert __CLIENT__.crt
key __CLIENT__.key
remote-cert-tls server
tls-auth ta.key 1
key-direction 1
## tls-crypt ta.key

remote __VPN_HOST__ __VPN_PORT_FALLBACK__
nobind
persist-tun
persist-key
auth-nocache

redirect-gateway def1

tls-version-min 1.2
data-ciphers AES-256-GCM:AES-128-GCM:CHACHA20-POLY1305
data-ciphers-fallback AES-128-GCM
auth SHA256

tun-mtu 1500

verb 3
